# ─────────────────────────────────────────────────────────────────────────────
# Next.js app environment (copy to .env.local for local dev)
# Validated with Zod in lib/env.ts — invalid/missing required vars fail the build.
# ─────────────────────────────────────────────────────────────────────────────

# URL of your Convex deployment. REQUIRED.
# Locally this is written automatically into .env.local by `npx convex dev`.
# In production it is injected by the Vercel build command
# (`npx convex deploy --cmd 'npm run build'`), so you usually don't set it by hand.
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"

# Public site origin, used by robots.txt and sitemap.xml. Optional.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Convex production deploy key — used ONLY by the Vercel build step. Optional locally.
# Get it from the Convex dashboard → Settings → Deploy keys.
CONVEX_DEPLOY_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Convex deployment environment (validated with Zod in convex/env.ts)
# These live ON the deployment — set them with `npx convex env set NAME value`
# (append `--prod` for production). They are NOT read from this file.
# ─────────────────────────────────────────────────────────────────────────────
#
#   ADMIN_SIGNUP_KEY   Shared secret required to create the owner account on /admin.
#                      e.g.  npx convex env set ADMIN_SIGNUP_KEY letmein
#                      Clear it after registering: npx convex env set ADMIN_SIGNUP_KEY ""
#
#   R2_PUBLIC_URL      Public base URL of your Cloudflare R2 bucket. Optional;
#                      only needed when migrating image storage from Convex to R2.
#
# Set automatically by Convex / the auth setup CLI (do not set manually):
#   CONVEX_DEPLOYMENT, CONVEX_SITE_URL, NEXT_PUBLIC_CONVEX_SITE_URL,
#   SITE_URL, JWT_PRIVATE_KEY, JWKS
